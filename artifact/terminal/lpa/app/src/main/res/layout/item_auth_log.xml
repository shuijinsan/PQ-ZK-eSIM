<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_light"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/item_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUCCESS"
            android:textColor="#00D4AA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/bg_badge_green"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/item_tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="2026-05-28 19:42:00"
            android:textColor="#1F2937"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/item_tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="142 ms"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/item_tv_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session UUID: tx_7a2b9c4d..."
            android:textColor="#6B7280"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/item_tv_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Phone Number: +86 138-0001-0001"
            android:textColor="#6B7280"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
