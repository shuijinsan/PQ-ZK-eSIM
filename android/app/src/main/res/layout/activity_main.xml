<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/tv_eid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EID: 8986000000000000001"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="安全状态: 待认证"
                android:textColor="#FF9800" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="认证控制台"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/auth_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:progress="0"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_run_test"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="首次身份认证 (指纹/人脸)"
        android:backgroundTint="#1A73E8"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_quick_biz"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="快速办理业务 (免证明)"
        android:enabled="false"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="实时安全审计 (Logcat)"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#1E1E1E">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_audit_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="> 系统就绪，等待认证触发...\n"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                android:textSize="12sp" />
        </ScrollView>
    </androidx.cardview.widget.CardView>

</LinearLayout>